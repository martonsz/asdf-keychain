#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=/dev/null
source "${plugin_dir}/lib/utils.bash"

# Download to a scratch dir first so a failed download leaves no files behind
# in ASDF_DOWNLOAD_PATH.
scratch_dir=$(mktemp -d)
trap 'rm -rf "$scratch_dir"' EXIT

# The release asset is a self-contained zipapp, so there is nothing to extract.
download_release "$ASDF_INSTALL_VERSION" "$scratch_dir/$TOOL_NAME"
chmod +x "$scratch_dir/$TOOL_NAME"

mkdir -p "$ASDF_DOWNLOAD_PATH"
mv "$scratch_dir/$TOOL_NAME" "$ASDF_DOWNLOAD_PATH/$TOOL_NAME"
